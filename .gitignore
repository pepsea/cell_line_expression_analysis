# Built databases - rebuilt from the HPA download files, never committed.
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm

# Raw HPA downloads, if placed inside the repo.
*.tsv
*.tsv.zip
*.tsv.gz
!tests/**/*.tsv
!hpa_cellexp/reference/*.tsv

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.DS_Store
!data/.gitkeep

# Local mount points used by docker compose.  The override folders are
# tracked (their READMEs explain what goes in them) but their contents are
# yours: local TSVs and the ~200 MiB cellosaurus.txt stay out of the repo.
hpa-source/
reference/*
!reference/README.md
cellosaurus/*
!cellosaurus/README.md

# Local compose settings (copy from .env.example).
.env
