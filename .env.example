# Copy to .env - docker compose reads it automatically.
#   cp .env.example .env && docker compose up -d

# ブラウザでアクセスするポート（ホスト側）。
# コンテナ内は常に 8000 で待ち受け、ここを変えても他の設定は不要です。
HPA_CELLEXP_PORT=8000

# HPA の配布ファイルを置いたディレクトリ。/source に読み取り専用でマウントされます。
HPA_SOURCE_DIR=./hpa-source

# 参照テーブル（tcga_organ.tsv / labels_ja.tsv / cell_line_organ.tsv /
# organ_keywords.tsv）を置いたディレクトリ。/reference にマウントされます。
# ここに置いたファイルが優先され、無いものはパッケージ同梱版が使われます
# （ファイル単位なので、1つだけ差し替えることができます）。
HPA_REFERENCE_DIR=./reference

# cellosaurus.txt を置いたディレクトリと、そのファイル名。
# 約 200 MiB あり更新サイクルも HPA とは別なので、独立したフォルダにしてあります。
HPA_CELLOSAURUS_DIR=./cellosaurus
HPA_CELLOSAURUS_FILE=/cellosaurus/cellosaurus.txt

# ワーカープロセス数。DB は読み取り専用で開くため安全に増やせます。
HPA_CELLEXP_WORKERS=1
