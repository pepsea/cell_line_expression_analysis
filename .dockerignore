# The database is mounted at /data, never baked into the image.
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Raw HPA downloads are mounted read-only at /source.
*.tsv
*.tsv.zip
*.tsv.gz
!hpa_cellexp/reference/*.tsv

# Override folders are bind-mounted at /reference and /cellosaurus; baking
# them in would shadow the mount with a stale copy.
reference/
cellosaurus/

.git/
.github/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
tests/
.DS_Store
Dockerfile
docker-compose.yml
.dockerignore
