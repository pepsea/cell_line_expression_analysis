# Copy to .env - docker compose reads it automatically.
#   cp .env.example .env && docker compose up -d

# ブラウザでアクセスするポート（ホスト側）。
# コンテナ内は常に 8000 で待ち受け、ここを変えても他の設定は不要です。
HPA_CELLEXP_PORT=8000

# HPA の配布ファイルを置いたディレクトリ。/source に読み取り専用でマウントされます。
HPA_SOURCE_DIR=./hpa-source

# ワーカープロセス数。DB は読み取り専用で開くため安全に増やせます。
HPA_CELLEXP_WORKERS=1
